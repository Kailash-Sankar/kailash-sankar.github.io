---
/** Luna the lab. Decorative, like the rest of the scene. */
---

<!-- Decorative background scene. Purely presentational. -->
<div class="garden" aria-hidden="true">
  <div class="garden-sky"></div>
  <div class="garden-sun"></div>
  <div class="garden-moon"></div>
  <div class="garden-cloud garden-cloud--one"></div>
  <div class="garden-cloud garden-cloud--two"></div>

  <div class="breeze">
    <i class="breeze-line breeze-line--one"></i>
    <i class="breeze-line breeze-line--two"></i>
    <i class="breeze-line breeze-line--three"></i>
    <i class="breeze-line breeze-line--four"></i>
    <i class="breeze-line breeze-line--five"></i>
  </div>

  <div class="garden-terrain">
    <div class="garden-hills"></div>
  </div>

  <div class="luna">
    <div class="luna-ground" aria-hidden="true"></div>

    <!--
        Luna the labrador. Every shape below is generated by
        src/scripts/luna.mjs, which builds the dog from overlapping anatomical
        parts. Edit that file and paste its output here; do not hand-edit the
        path data, or the two will drift apart.
      -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 152 118" width="152" height="118" focusable="false">
        <!-- tail: own element so it can wag, base buried inside the haunch -->
        <path class="luna-tail" style="transform-origin: 30px 16px" d="M 46 50 C 39 44, 30 40, 23 40 C 17 40, 16 47, 22 48 C 30 51, 40 56, 44 62 Z" fill="var(--dog-coat)" />

        <!-- legs first, then the torso over their tops, so the joins stay hidden -->
        <path class="luna-hind" d="M 48 52 C 44 62, 44 72, 48 80 C 50 86, 50 92, 50 100 Q 50 104 54 104 L 64 104 Q 68 104 68 100 L 66 70 C 64 62, 62 56, 60 52 Z" fill="var(--dog-coat)" />
        <path class="luna-fore" d="M 78 50 L 78 100 Q 78 104 82 104 L 94 104 Q 98 104 98 100 L 98 50 Z" fill="var(--dog-coat)" />
        <path class="luna-body" d="M 46 52 C 56 47, 68 44, 78 44 C 86 45, 93 49, 98 55 C 102 61, 100 70, 94 73 C 82 77, 64 74, 56 70 C 49 67, 44 63, 42 59 C 40 56, 43 53, 46 52 Z" fill="var(--dog-coat)" />

        <!-- head group: neck, skull, muzzle, ear and eye, so it can breathe as a unit -->
        <g class="luna-head">
          <path d="M 80 70 C 80 48, 87 30, 96 24 C 101 20, 109 20, 115 24 C 119 27, 121 29, 125 30 C 129 31, 133 34, 135 38 C 136 41, 135 44, 133 46 C 129 48, 125 47, 122 46 C 118 46, 115 48, 113 53 C 110 60, 103 66, 97 69 C 92 71, 84 71, 80 70 Z" fill="var(--dog-coat)" />
          <path class="luna-ear" d="M 110 24 C 103 26, 100 36, 101 46 C 102 52, 106 53, 109 50 C 112 46, 113 34, 112 27 C 111 24, 111 23, 110 24 Z" fill="var(--dog-shade)" />
          <path d="M 132 36 C 136 35, 139 38, 138 42 C 137 45, 133 46, 131 45 C 128 43, 129 37, 132 36 Z" fill="var(--dog-dark)" />
          <circle cx="114" cy="34" r="1.8" fill="var(--dog-dark)" />
        </g>
      </svg>

    <!-- Petals for Luna's click easter egg. They live in the template (rather
         than being created in JS) so Astro's scoped styles apply; petLuna.ts
         only retriggers their animation. -->
    <div class="luna-petals">
      <span class="luna-petal"></span>
      <span class="luna-petal"></span>
      <span class="luna-petal"></span>
      <span class="luna-petal"></span>
    </div>
  </div>
</div>

<!-- Transparent hit target for Luna's click easter egg. It has to sit above
     the content layer: main (z-index 1) covers the whole fixed scene, so a
     click would otherwise land on the page, not on her. Pointer-fine only —
     on touch screens the right margin can sit over body copy. -->
<button class="luna-pet" type="button" aria-label="Pet Luna"></button>

<style>
  .garden {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The terrain is the only part of the scene dark enough to threaten text
     contrast, so it is the only part that recedes. Sky, sun, clouds and the
     breeze stay at full strength for the whole page, which is what keeps the
     scene feeling alive while you read. */
  .garden-terrain {
    opacity: var(--scene-fade, 1);
    will-change: opacity;
  }

  /* --- Sky ------------------------------------------------------------ */

  .garden-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 100%);
  }

  /* Stars fade in only in dark mode. */
  .garden-sky::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image:
      radial-gradient(circle at 12% 28%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 25% 18%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 41% 33%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 62% 16%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 76% 35%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 88% 20%, #f5edbf 0 1px, transparent 1.5px);
    transition: opacity var(--t-slow) var(--ease);
  }

  :global([data-theme="dark"]) .garden-sky::before {
    opacity: 0.7;
  }

  /* --- Sun and moon --------------------------------------------------- */

  .garden-sun,
  .garden-moon {
    position: absolute;
    z-index: 1;
    top: 12%;
    right: 10%;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    transform: translate3d(var(--scene-sun-x, 0px), var(--scene-sun-y, 0px), 0);
    will-change: transform;
  }

  .garden-sun {
    background: var(--sun);
    opacity: 0.5;
  }

  .garden-moon {
    top: 20%;
    right: 11%;
    width: 104px;
    height: 104px;
    background: var(--moon);
    box-shadow: -9px 5px 0 0 var(--bg);
    opacity: 0;
    transition: opacity var(--t-slow) var(--ease);
  }

  :global([data-theme="dark"]) .garden-sun {
    opacity: 0;
  }

  :global([data-theme="dark"]) .garden-moon {
    opacity: 0.9;
  }

  /* --- Clouds --------------------------------------------------------- */

  /* The drift animation and the scroll offset both need to drive `transform`,
     so drift animates a registered custom property instead and the two are
     composed. Animating `transform` directly would clobber the scroll offset. */
  @property --drift {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  .garden-cloud {
    position: absolute;
    z-index: 2;
    top: 22%;
    left: 12%;
    width: 138px;
    height: 22px;
    border-radius: 100px;
    background: var(--cloud);
    transform: translate3d(calc(var(--scene-cloud-shift, 0px) + var(--drift)), 0, 0);
    animation: drift 20s var(--ease) infinite;
    will-change: transform;
  }

  .garden-cloud::before,
  .garden-cloud::after {
    content: "";
    position: absolute;
    bottom: 0;
    border-radius: 50%;
    background: inherit;
  }

  .garden-cloud::before {
    width: 46px;
    height: 46px;
    left: 24px;
  }

  .garden-cloud::after {
    width: 32px;
    height: 32px;
    left: 65px;
  }

  .garden-cloud--one {
    left: 12%;
  }

  .garden-cloud--two {
    top: 35%;
    right: 13%;
    left: auto;
    width: 96px;
    opacity: 0.4;
    animation-duration: 25s;
    animation-delay: -8s;
  }

  /* --- Breeze --------------------------------------------------------- */

  /* Thin drifting lines suggesting a light wind. Kept deliberately faint:
     they sit behind body text and must never compete with it. */
  .breeze {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .breeze-line {
    position: absolute;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--breeze);
    opacity: 0.32;
    transform: translate3d(-30vw, 0, 0);
    animation: blow linear infinite;
    will-change: transform;
  }

  .breeze-line--one {
    top: 18%;
    width: 90px;
    opacity: 0.3;
    animation-duration: 13s;
    animation-delay: -2s;
  }

  .breeze-line--two {
    top: 27%;
    width: 140px;
    opacity: 0.22;
    animation-duration: 17s;
    animation-delay: -9s;
  }

  .breeze-line--three {
    top: 34%;
    width: 60px;
    opacity: 0.26;
    animation-duration: 10s;
    animation-delay: -5s;
  }

  .breeze-line--four {
    top: 44%;
    width: 110px;
    opacity: 0.18;
    animation-duration: 21s;
    animation-delay: -14s;
  }

  .breeze-line--five {
    top: 12%;
    width: 45px;
    opacity: 0.2;
    animation-duration: 15s;
    animation-delay: -7s;
  }

  /* --- Hills ---------------------------------------------------------- */

  .garden-hills {
    position: absolute;
    z-index: 3;
    left: -10%;
    bottom: -22%;
    width: 120%;
    height: 50%;
    border-radius: 50% 50% 0 0;
    background: var(--hill-back);
    transform: translate3d(0, var(--scene-ground-shift, 0px), 0) rotate(-2deg);
    will-change: transform;
  }

  .garden-hills::after {
    content: "";
    position: absolute;
    right: -8%;
    bottom: -38%;
    width: 76%;
    height: 90%;
    border-radius: 50% 50% 0 0;
    background: var(--hill-front);
    transform: rotate(4deg);
  }

  /* --- Luna ----------------------------------------------------------- */

  .luna {
    position: absolute;
    z-index: 4;
    /* In the right margin, outside the text column, so she never sits under
       body copy. Right offset is capped so she stays clear of the gutter
       content ends at. */
    right: clamp(4px, 2.4vw, 34px);
    bottom: 19%;
    width: clamp(74px, 7vw, 104px);
  }

  /* Transparent click target aligned to Luna, sitting above the content
     layer (which covers the fixed scene). */
  .luna-pet {
    position: fixed;
    z-index: 2;
    right: clamp(4px, 2.4vw, 34px);
    bottom: 19%;
    width: clamp(74px, 7vw, 104px);
    aspect-ratio: 152 / 118;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 8px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* On touch screens the margin can overlap body copy, so leave her be. */
  @media (pointer: coarse) {
    .luna-pet {
      display: none;
    }
  }

  /* Her own ground, so she stays planted once the hills recede. */
  .luna-ground {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 78%;
    height: 12px;
    border-radius: 50%;
    background: var(--dog-shadow);
    transform: translateX(-50%);
    filter: blur(3px);
  }

  .luna svg {
    display: block;
    position: relative;
    width: 100%;
    height: auto;
    /* The artwork is authored facing right; mirror it so Luna looks left,
       toward the text column. Because it is a rigid flip, the tail's inline
       pivot and the head/ear transform-origins all mirror with it. */
    transform: scaleX(-1);
    filter: drop-shadow(0 4px 6px rgb(38 51 44 / 0.12));
  }

  /* --- Luna's click easter egg ---------------------------------------- */

  /* Hop the drawing, not the wrapper, so her ground shadow stays put. The
     static scaleX(-1) mirror has to be repeated in every frame. */
  .luna.is-happy svg {
    animation: luna-hop 700ms var(--ease);
  }

  /* A burst of wagging while she is happy. */
  .luna.is-happy .luna-tail {
    animation-duration: 0.3s;
  }

  @keyframes luna-hop {
    0% {
      transform: scaleX(-1) translateY(0) rotate(0deg);
    }
    30% {
      transform: scaleX(-1) translateY(-9px) rotate(-2deg);
    }
    55% {
      transform: scaleX(-1) translateY(0) rotate(0deg) scaleY(0.97);
    }
    78% {
      transform: scaleX(-1) translateY(-3px) rotate(1.5deg);
    }
    100% {
      transform: scaleX(-1) translateY(0) rotate(0deg);
    }
  }

  /* The pivot is set inline on the element, generated from the path geometry,
     so it can never drift from the drawing. */
  .luna-tail {
    transform-box: fill-box;
    animation: wag 0.9s var(--ease) infinite alternate;
  }

  .luna-head {
    transform-box: fill-box;
    transform-origin: left bottom;
    animation: luna-breathe 4s var(--ease) infinite;
  }

  .luna-ear {
    transform-box: fill-box;
    transform-origin: top center;
    animation: ear-flop 4s var(--ease) infinite;
  }

  /* Range is bounded so the tail's base stays buried inside the haunch
     throughout the swing; see TAIL_PIVOT in src/scripts/luna.mjs. */
  @keyframes wag {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(13deg);
    }
  }

  @keyframes luna-breathe {
    0%,
    100% {
      transform: translateY(0) scaleY(1);
    }
    50% {
      transform: translateY(-0.6px) scaleY(1.015);
    }
  }

  @keyframes ear-flop {
    0%,
    88%,
    100% {
      transform: rotate(0deg);
    }
    93% {
      transform: rotate(7deg);
    }
  }

  /* Leaves that tumble up when Luna is petted. Per-petal size, colour, path
     and timing live on the :nth-child rules below so the cluster fans out;
     petLuna.ts only restarts the animation. */
  .luna-petals {
    position: absolute;
    left: 46%;
    top: 18%;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .luna-petal {
    position: absolute;
    width: 9px;
    height: 12px;
    /* Opposite corners rounded, so a square reads as a leaf/petal. */
    border-radius: 100% 0 100% 0;
    background: var(--petal-day, #c07a3e);
    opacity: 0;
    transform: translate(-50%, 0);
  }

  /* Warm leaves against the daylight sky; luminous petals once it is dark. */
  :global([data-theme="dark"]) .luna-petal {
    background: var(--petal-night, #e8d09b);
  }

  .luna-petal:nth-child(1) {
    --petal-day: #c07a3e;
    --petal-night: #e8d09b;
    --dx: -16px;
    --rise: -54px;
    --rot: 210deg;
    --dur: 1350ms;
    --delay: 0ms;
    width: 10px;
    height: 13px;
  }

  .luna-petal:nth-child(2) {
    --petal-day: #d9a441;
    --petal-night: #f0dcae;
    --dx: -6px;
    --rise: -60px;
    --rot: -160deg;
    --dur: 1500ms;
    --delay: 90ms;
    width: 8px;
    height: 11px;
  }

  .luna-petal:nth-child(3) {
    --petal-day: #a4552f;
    --petal-night: #d8b877;
    --dx: -22px;
    --rise: -46px;
    --rot: 260deg;
    --dur: 1250ms;
    --delay: 180ms;
    width: 11px;
    height: 9px;
  }

  .luna-petal:nth-child(4) {
    --petal-day: #c98a4b;
    --petal-night: #e3c98f;
    --dx: -10px;
    --rise: -64px;
    --rot: -190deg;
    --dur: 1650ms;
    --delay: 70ms;
    width: 8px;
    height: 10px;
  }

  /* Reduced-motion fallback: the global reset zeroes animation durations, so
     petLuna.ts reveals the petals statically, pre-spread, instead. */
  .luna-petal.is-shown {
    opacity: 1;
    transform: translate(
        calc(-50% + var(--dx, 0px) * 0.6),
        calc(var(--rise, -56px) * 0.6)
      )
      rotate(var(--rot, 0deg));
  }

  .luna-petal.is-animating {
    animation: petal-rise var(--dur, 1400ms) var(--ease) forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes petal-rise {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) rotate(0deg) scale(0.55);
    }
    15% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--dx, 0px)), var(--rise, -56px))
        rotate(var(--rot, 180deg)) scale(1);
    }
  }

  @media (max-width: 760px) {
    .garden-sun {
      right: -60px;
      width: 150px;
      height: 150px;
    }

    .luna,
    .luna-pet {
      bottom: 15%;
      width: 78px;
    }
  }
</style>
