---
/** Luna the lab. Decorative, like the rest of the scene. */
---

<!-- Decorative background scene. Purely presentational. -->
<div class="garden" aria-hidden="true">
  <div class="garden-sky"></div>
  <div class="garden-sun"></div>
  <div class="garden-moon"></div>
  <div class="garden-cloud garden-cloud--one"></div>
  <div class="garden-cloud garden-cloud--two"></div>

  <div class="breeze">
    <i class="breeze-line breeze-line--one"></i>
    <i class="breeze-line breeze-line--two"></i>
    <i class="breeze-line breeze-line--three"></i>
    <i class="breeze-line breeze-line--four"></i>
    <i class="breeze-line breeze-line--five"></i>
  </div>

  <div class="garden-terrain">
    <div class="garden-hills"></div>
    <div class="garden-grass garden-grass--one"></div>
    <div class="garden-grass garden-grass--two"></div>
    <div class="garden-grass garden-grass--three"></div>
  </div>

  <div class="luna">
    <div class="luna-ground" aria-hidden="true"></div>

    <!--
        Luna the labrador. The outline below is generated by
        src/scripts/luna.mjs, which derives the smooth path from anatomical
        keypoints. Edit the keypoints there rather than the path data here, or
        the two will drift apart.
      -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 152 118" width="152" height="118" focusable="false">
    <!-- tail: own element so it can wag, base buried inside the haunch -->
    <path class="luna-tail" style="transform-origin: 31px 18px" d="M33 66 C20 67 8 60 2 50 C1 46 4 43 7 46 C12 54 22 56 33 56 Z" fill="var(--dog-coat)" />

    <path class="luna-body" d="M 33 54 C 36.17 53.83, 42.83 54.17, 48 54 C 53.17 53.83, 58.67 54.17, 64 53 C 69.33 51.83, 74.33 49.83, 80 47 C 85.67 44.17, 93.33 39.00, 98 36 C 102.67 33.00, 104.67 30.00, 108 29 C 111.33 28.00, 114.83 29.17, 118 30 C 121.17 30.83, 124.50 32.67, 127 34 C 129.50 35.33, 131.50 36.83, 133 38 C 134.50 39.17, 136.17 39.83, 136 41 C 135.83 42.17, 134.33 44.33, 132 45 C 129.67 45.67, 125.67 44.50, 122 45 C 118.33 45.50, 113.67 46.83, 110 48 C 106.33 49.17, 102.33 49.67, 100 52 C 97.67 54.33, 96.83 58.33, 96 62 C 95.17 65.67, 95.17 67.00, 95 74 C 94.83 81.00, 96.83 99.00, 95 104 C 93.17 109.00, 85.83 109.67, 84 104 C 82.17 98.33, 86.33 75.50, 84 70 C 81.67 64.50, 74.33 70.50, 70 71 C 65.67 71.50, 60.00 67.50, 58 73 C 56.00 78.50, 60.00 98.83, 58 104 C 56.00 109.17, 48.00 109.00, 46 104 C 44.00 99.00, 47.00 79.33, 46 74 C 45.00 68.67, 42.33 73.00, 40 72 C 37.67 71.00, 34.00 69.67, 32 68 C 30.00 66.33, 28.50 64.17, 28 62 C 27.50 59.83, 28.17 56.33, 29 55 C 29.83 53.67, 29.83 54.17, 33 54 Z" fill="var(--dog-coat)" />

    <!-- head group: skull, muzzle, ear and eye, so it can breathe as a unit -->
    <g class="luna-head">
    <!-- ear: narrow teardrop hanging off the back of the skull -->
    <path class="luna-ear" d="M100 35 C96 37 94 43 95 48 C96 53 100 55 103 52 C105 49 105 44 104 40 C103 36 102 35 100 35 Z" fill="var(--dog-shade)" />
    <path d="M132 40 C136 40 138 42 136 44 C134 46 130 45 129 43 Z" fill="var(--dog-dark)" />
    <circle cx="119" cy="37" r="1.9" fill="var(--dog-dark)" />
    </g>
    </svg>
  </div>
</div>

<style>
  .garden {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The terrain is the only part of the scene dark enough to threaten text
     contrast, so it is the only part that recedes. Sky, sun, clouds and the
     breeze stay at full strength for the whole page, which is what keeps the
     scene feeling alive while you read. */
  .garden-terrain {
    opacity: var(--scene-fade, 1);
    will-change: opacity;
  }

  /* --- Sky ------------------------------------------------------------ */

  .garden-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 100%);
  }

  /* Stars fade in only in dark mode. */
  .garden-sky::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image:
      radial-gradient(circle at 12% 28%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 25% 18%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 41% 33%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 62% 16%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 76% 35%, #f5edbf 0 1px, transparent 1.5px),
      radial-gradient(circle at 88% 20%, #f5edbf 0 1px, transparent 1.5px);
    transition: opacity var(--t-slow) var(--ease);
  }

  :global([data-theme="dark"]) .garden-sky::before {
    opacity: 0.7;
  }

  /* --- Sun and moon --------------------------------------------------- */

  .garden-sun,
  .garden-moon {
    position: absolute;
    z-index: 1;
    top: 12%;
    right: 10%;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    transform: translate3d(var(--scene-sun-x, 0px), var(--scene-sun-y, 0px), 0);
    will-change: transform;
  }

  .garden-sun {
    background: var(--sun);
    opacity: 0.5;
  }

  .garden-moon {
    top: 20%;
    right: 11%;
    width: 104px;
    height: 104px;
    background: var(--moon);
    box-shadow: -9px 5px 0 0 var(--bg);
    opacity: 0;
    transition: opacity var(--t-slow) var(--ease);
  }

  :global([data-theme="dark"]) .garden-sun {
    opacity: 0;
  }

  :global([data-theme="dark"]) .garden-moon {
    opacity: 0.9;
  }

  /* --- Clouds --------------------------------------------------------- */

  /* The drift animation and the scroll offset both need to drive `transform`,
     so drift animates a registered custom property instead and the two are
     composed. Animating `transform` directly would clobber the scroll offset. */
  @property --drift {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  .garden-cloud {
    position: absolute;
    z-index: 2;
    top: 22%;
    left: 12%;
    width: 138px;
    height: 22px;
    border-radius: 100px;
    background: var(--cloud);
    transform: translate3d(calc(var(--scene-cloud-shift, 0px) + var(--drift)), 0, 0);
    animation: drift 20s var(--ease) infinite;
    will-change: transform;
  }

  .garden-cloud::before,
  .garden-cloud::after {
    content: "";
    position: absolute;
    bottom: 0;
    border-radius: 50%;
    background: inherit;
  }

  .garden-cloud::before {
    width: 46px;
    height: 46px;
    left: 24px;
  }

  .garden-cloud::after {
    width: 32px;
    height: 32px;
    left: 65px;
  }

  .garden-cloud--one {
    left: 12%;
  }

  .garden-cloud--two {
    top: 35%;
    right: 13%;
    left: auto;
    width: 96px;
    opacity: 0.4;
    animation-duration: 25s;
    animation-delay: -8s;
  }

  /* --- Breeze --------------------------------------------------------- */

  /* Thin drifting lines suggesting a light wind. Kept deliberately faint:
     they sit behind body text and must never compete with it. */
  .breeze {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .breeze-line {
    position: absolute;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--breeze);
    opacity: 0.32;
    transform: translate3d(-30vw, 0, 0);
    animation: blow linear infinite;
    will-change: transform;
  }

  .breeze-line--one {
    top: 18%;
    width: 90px;
    opacity: 0.3;
    animation-duration: 13s;
    animation-delay: -2s;
  }

  .breeze-line--two {
    top: 27%;
    width: 140px;
    opacity: 0.22;
    animation-duration: 17s;
    animation-delay: -9s;
  }

  .breeze-line--three {
    top: 34%;
    width: 60px;
    opacity: 0.26;
    animation-duration: 10s;
    animation-delay: -5s;
  }

  .breeze-line--four {
    top: 44%;
    width: 110px;
    opacity: 0.18;
    animation-duration: 21s;
    animation-delay: -14s;
  }

  .breeze-line--five {
    top: 12%;
    width: 45px;
    opacity: 0.2;
    animation-duration: 15s;
    animation-delay: -7s;
  }

  /* --- Hills and grass ------------------------------------------------ */

  .garden-hills {
    position: absolute;
    z-index: 3;
    left: -10%;
    bottom: -22%;
    width: 120%;
    height: 50%;
    border-radius: 50% 50% 0 0;
    background: var(--hill-back);
    transform: translate3d(0, var(--scene-ground-shift, 0px), 0) rotate(-2deg);
    will-change: transform;
  }

  .garden-hills::after {
    content: "";
    position: absolute;
    right: -8%;
    bottom: -38%;
    width: 76%;
    height: 90%;
    border-radius: 50% 50% 0 0;
    background: var(--hill-front);
    transform: rotate(4deg);
  }

  .garden-grass {
    position: absolute;
    z-index: 4;
    bottom: 13%;
    width: 2px;
    height: 50px;
    background: var(--grass);
    transform-origin: bottom;
    animation: sway 3s var(--ease) infinite;
  }

  .garden-grass::after {
    content: "";
    position: absolute;
    width: 2px;
    height: 32px;
    background: inherit;
    transform: rotate(34deg);
    transform-origin: bottom;
  }

  .garden-grass--one {
    left: 18%;
  }

  .garden-grass--two {
    left: 51%;
    height: 38px;
    animation-delay: -1s;
  }

  .garden-grass--three {
    right: 18%;
    height: 62px;
    animation-delay: -0.5s;
  }

  /* --- Luna ----------------------------------------------------------- */

  .luna {
    position: absolute;
    z-index: 4;
    /* In the right margin, outside the text column, so she never sits under
       body copy. Right offset is capped so she stays clear of the gutter
       content ends at. */
    right: clamp(4px, 2.4vw, 34px);
    bottom: 19%;
    width: clamp(74px, 7vw, 104px);
  }

  /* Her own ground, so she stays planted once the hills recede. */
  .luna-ground {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 78%;
    height: 12px;
    border-radius: 50%;
    background: var(--dog-shadow);
    transform: translateX(-50%);
    filter: blur(3px);
  }

  .luna svg {
    display: block;
    position: relative;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 6px rgb(38 51 44 / 0.12));
  }

  /* The pivot is set inline on the element, generated from the path geometry,
     so it can never drift from the drawing. */
  .luna-tail {
    transform-box: fill-box;
    animation: wag 0.9s var(--ease) infinite alternate;
  }

  .luna-head {
    transform-box: fill-box;
    transform-origin: left bottom;
    animation: luna-breathe 4s var(--ease) infinite;
  }

  .luna-ear {
    transform-box: fill-box;
    transform-origin: top center;
    animation: ear-flop 4s var(--ease) infinite;
  }

  /* Range is bounded so the tail's base stays buried inside the haunch
     throughout the swing; see TAIL_PIVOT in src/scripts/luna.mjs. */
  @keyframes wag {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(13deg);
    }
  }

  @keyframes luna-breathe {
    0%,
    100% {
      transform: translateY(0) scaleY(1);
    }
    50% {
      transform: translateY(-0.6px) scaleY(1.015);
    }
  }

  @keyframes ear-flop {
    0%,
    88%,
    100% {
      transform: rotate(0deg);
    }
    93% {
      transform: rotate(7deg);
    }
  }

  @media (max-width: 760px) {
    .garden-sun {
      right: -60px;
      width: 150px;
      height: 150px;
    }

    .luna {
      bottom: 15%;
      width: 78px;
    }
  }
</style>
