---
import { writing, writingProfileUrl } from "../data/writing";
---

<section class="section" id="writing" aria-labelledby="writing-title">
  <div class="section-heading">
    <h2 id="writing-title">Notes from the field.</h2>
    <a class="text-link" href={writingProfileUrl} target="_blank" rel="noreferrer">
      All writing <span aria-hidden="true">↗</span>
    </a>
  </div>

  <ul class="writing-grid">
    {
      writing.map((post, index) => (
        <li>
          <a
            class:list={["card", "writing-card", index === 0 && "writing-card--featured"]}
            href={post.href}
            target="_blank"
            rel="noreferrer"
          >
            <div class="card-meta">
              <span>{post.date}</span>
              <span>{String(index + 1).padStart(2, "0")}</span>
            </div>

            <div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </div>

            <div class="card-footer">
              <span>{post.tags.join(" · ")}</span>
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .writing-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 350px;
    height: 100%;
    padding: 24px;
  }

  .writing-card:hover {
    transform: translateY(-6px) rotate(-0.5deg);
  }

  /* The newest post. Deliberately a warm tint rather than a green one: the
     page and the scene are already green, and a green card on green read as
     a mistake. */
  .writing-card--featured {
    background: var(--surface-raised);
    border-color: transparent;
  }

  .writing-card--featured:hover {
    background: var(--surface-raised);
    border-color: var(--accent);
  }

  .card-meta,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-faint);
    font: var(--step--2) var(--font-mono);
  }

  .card-footer {
    padding-top: 28px;
  }

  .writing-card h3 {
    max-width: 300px;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--track-tight);
  }

  .writing-card p {
    max-width: 34ch;
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-size: 18px;
    line-height: 1;
  }

  @media (max-width: 980px) {
    .writing-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .writing-grid {
      grid-template-columns: 1fr;
    }

    .writing-card {
      min-height: 295px;
    }

    .section-heading .text-link {
      position: static;
      display: inline-flex;
      margin-top: 25px;
    }
  }
</style>
