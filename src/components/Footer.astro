---
import { profile } from "../data/profile";

const year = new Date().getFullYear();

const links = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/kailash-sankar/" },
  { label: "GitHub", href: "https://github.com/Kailash-Sankar" },
  { label: "DEV", href: "https://dev.to/ksankar" },
];
---

<footer class="footer">
  <span>© {year} {profile.name}</span>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    padding: 28px var(--gutter-tight);
    color: var(--text-faint);
    font: var(--step--2) var(--font-mono);
  }

  .footer ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    transition: color var(--t-fast) var(--ease);
  }

  .footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .footer {
      flex-direction: column;
      gap: 18px;
    }
  }
</style>
