---
import { profile, social } from "../data/profile";
---

<section class="hero" aria-labelledby="intro-title">
  <div class="hero-copy">
    <h1 id="intro-title">
      Making useful things,<br /><em>one thoughtful step</em> at a time.
    </h1>
    <p class="intro">{profile.intro}</p>

    <div class="hero-actions">
      <a class="button button--primary" href="#writing">
        Read my writing <span aria-hidden="true">↓</span>
      </a>
      <a class="text-link" href={social.github} target="_blank" rel="noreferrer">
        Find me on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <a class="scroll-cue" href="#writing" aria-label="Scroll to writing">
    <span class="scroll-cue-line" aria-hidden="true"></span>
    <span class="scroll-cue-text">Scroll</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 800px;
    padding: clamp(76px, 12vw, 160px) var(--gutter) 0;
    overflow: hidden;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 740px;
    animation: rise 0.8s var(--ease) both;
  }

  .hero h1 {
    margin-bottom: 30px;
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: var(--track-display);
  }

  .intro {
    max-width: 44ch;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 38px;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 730px;
      padding-top: 100px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }</style>
