---
import { profile } from "../data/profile";
---

<section class="section about" aria-labelledby="about-title">
  <div class="about-head">
    <!-- A real label rather than mood-setting: this is the one place the
         focus areas are stated, and labelling it makes them scannable. -->
    <p class="eyebrow">Current focus</p>
    <h2 id="about-title">Still curious.<br />Still making.</h2>
  </div>

  <div class="about-body">
    <p class="focus">
      {profile.focusAreas.map((area) => <span class="focus-item">{area}</span>)}
    </p>

    <div class="about-copy">
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    /* Two columns, so the heading lands on the same left edge as the hero,
       writing and work sections. This used to be 0.45fr 1fr 1.15fr, whose
       first column existed only to hold a decorative ✳ glyph — 21px of
       ornament reserving ~176px of space and pushing this section's text
       ~180px right of everything above it. */
    grid-template-columns: 1fr 1.15fr;
    gap: 30px;
    align-items: start;
    border-top: 1px solid var(--border);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* Written as a single line rather than bulleted: these describe one body of
     work, not a set of separate items. Matches the tag separator already
     used on the writing cards. */
  .focus {
    margin: 0;
    color: var(--text);
    font: var(--step--1) var(--font-mono);
    line-height: 1.9;
  }

  /* Each area stays whole; the line only ever breaks at a separator, so the
     row never looks misaligned. */
  .focus-item {
    white-space: nowrap;
  }

  .focus-item + :global(.focus-item)::before {
    content: " · ";
    color: var(--text-faint);
  }

  .about-copy {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: var(--step-0);
    line-height: 1.7;
  }

  .about-copy p + p {
    margin-top: 20px;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
