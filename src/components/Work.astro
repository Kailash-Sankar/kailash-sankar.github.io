---
import { projects } from "../data/projects";
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="section-heading heading--split">
    <div>
      <h2 id="work-title">Things I've built.</h2>
    </div>
    <p class="section-note">
      A few experiments and useful little tools. The full, untidy shelf is over on GitHub.
    </p>
  </div>

  <ul class="project-list">
    {
      projects.map((project, index) => (
        <li>
          <a class="project-row" href={project.href} target="_blank" rel="noreferrer">
            <span class="project-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="project-name">{project.name}</span>
            <span class="project-description">{project.description}</span>
            <span class="project-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    padding-top: 0;
  }

  .heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
  }

  .section-note {
    max-width: 34ch;
    margin-bottom: 4px;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-row {
    display: grid;
    grid-template-columns: 60px 1.2fr 2fr 30px;
    gap: 16px;
    align-items: center;
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
    transition:
      padding var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .project-row:hover {
    padding-left: 10px;
    color: var(--accent);
  }

  .project-index {
    color: var(--text-faint);
    font: var(--step--2) var(--font-mono);
  }

  .project-name {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--track-tight);
  }

  .project-description {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .project-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    color: var(--accent);
    font-size: 18px;
    line-height: 1;
  }

  @media (max-width: 760px) {
    .heading--split {
      display: block;
    }

    .section-note {
      margin-top: 25px;
    }

    .project-row {
      grid-template-columns: 32px 1fr 24px;
    }

    .project-description {
      display: none;
    }
  }
</style>
