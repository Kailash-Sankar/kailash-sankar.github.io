---
import { projects, projectProfileUrl } from "../data/projects";
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <h2 id="work-title">Things I've built.</h2>
    <a class="text-link" href={projectProfileUrl} target="_blank" rel="noreferrer">
      All projects <span aria-hidden="true">↗</span>
    </a>
  </div>

  <ul class="project-grid">
    {
      projects.map((project, index) => (
        <li class="card project-card">
          <div class="card-meta">
            <span>{project.language}</span>
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>

          <div>
            {/* The link is the title, not a wrapper. A card-wide <a> would
                have to contain the demo link, and anchors cannot nest. The
                title's ::after stretches over the card to make the whole
                thing clickable, and the demo link is lifted above it. */}
            <h3 class="project-name">
              <a href={project.href} target="_blank" rel="noreferrer">
                {project.name}
              </a>
            </h3>
            <p class="project-description">{project.description}</p>
          </div>

          <div class="card-footer">
            <span>{project.stack.join(" · ")}</span>
            <span class="project-links">
              {project.demo && (
                <a class="project-demo" href={project.demo} target="_blank" rel="noreferrer">
                  live
                </a>
              )}
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    padding-top: 0;
  }

  /* Equal thirds rather than the writing grid's 1.25fr 1fr 1fr. Nothing here
     is a featured piece, and the even rhythm keeps the two grids reading as
     siblings rather than the same template twice. */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 300px;
    height: 100%;
    padding: 24px;
  }

  .project-card:hover {
    transform: translateY(-6px) rotate(-0.5deg);
  }

  .project-name {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--track-tight);
  }

  /* Stretches the title's link over the whole card, so the entire surface is
     clickable without an anchor wrapping the card. */
  .project-name a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project-name a:focus-visible {
    outline: none;
  }

  /* Keeps the focus ring on the title itself rather than on the invisible
     full-card overlay, which would draw a rectangle the size of the card. */
  .project-card:has(.project-name a:focus-visible) {
    border-color: var(--accent);
    box-shadow: var(--card-shadow-hover);
  }

  .project-description {
    max-width: 34ch;
    margin-top: 14px;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .project-links {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  /* Above the stretched link overlay, so the demo link stays clickable. */
  .project-demo {
    position: relative;
    z-index: 1;
    color: var(--accent);
    text-decoration: none;
  }

  .project-demo:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    /* Kept rather than collapsed, so the meta strip, title and footer keep the
       same spacing they have on wider screens — matching the writing cards,
       which hold 295px on mobile for the same reason. */
    .project-card {
      min-height: 260px;
    }
  }
</style>
