---
import { profile } from "../data/profile";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <!-- Plain text and a button, laid out like the other sections. This used to
       sit on a .contact-card with a surface, radius and card-shadow, which is
       what kept reading as a panel even without a border or a hover state. -->
  <p class="eyebrow">Open to a conversation</p>

  <h2 id="contact-title">
    Have something<br /><em>interesting in mind?</em>
  </h2>

  <a class="button button--primary" href={`mailto:${profile.email}`}>
    Say hello <span aria-hidden="true">↗</span>
  </a>
</section>

<style>
  /* Shares the heading scale with the writing, work and about sections, so the
     closing line is the same size as the headings above it. */
  .contact h2 {
    max-width: 16ch;
    margin: 0 0 30px;
  }
</style>
