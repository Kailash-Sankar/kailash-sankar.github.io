---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import GardenScene from "../components/GardenScene.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Work from "../components/Work.astro";
import Writing from "../components/Writing.astro";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${profile.name} — software engineer & writer`}
  description={`${profile.name} — software engineer, writer, and curious builder.`}
>
  <Nav />
  <GardenScene />

  <main id="top">
    <Hero />
    <Writing />
    <Work />
    <About />
    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  import { initTheme } from "../scripts/theme";
  import { initGarden } from "../scripts/garden";

  initTheme();
  initGarden();
</script>
